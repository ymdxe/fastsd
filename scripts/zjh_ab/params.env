# shellcheck shell=bash
# Shared parameters for serve.sh (node2) and client.sh (node3).
# Each host only reads the values it needs; override any of them inline, e.g.
#   KV_RESIDENCY_BUDGET_MB=256 RUN_NAME=pressure-fastsd ./client.sh fastsd

# ---- experiment identity ---------------------------------------------------
# Resolved from the repo root regardless of the caller's cwd.
EXP_ROOT="${EXP_ROOT:-$(cd "$HERE/../.." && pwd)/exp/zjh_ab}"
RUN_NAME="${RUN_NAME:-}"                 # empty = use the condition name
DATASET="${DATASET:-humaneval}"
REQUESTS="${REQUESTS:-32}"
NUM_DRAFTS="${NUM_DRAFTS:-4}"
MAX_TOKENS="${MAX_TOKENS:-400}"
GAMMA="${GAMMA:-4}"
BATCH_SIZE="${BATCH_SIZE:-8}"
TOKEN_BUDGET="${TOKEN_BUDGET:-512}"
SEED="${SEED:-1234}"
EDGE_THREADS="${EDGE_THREADS:-8}"

# ---- models (shared NFS on every host) -------------------------------------
MODELS="${MODELS:-/mnt/nfs0/zhangh/models}"
TARGET_MODEL="${TARGET_MODEL:-$MODELS/Qwen3-8B}"
TARGET_MODEL_NODE2="${TARGET_MODEL_NODE2:-/home/hdd/zhangh/models/Qwen3-8B}"
DRAFT_MODEL="${DRAFT_MODEL:-$MODELS/Qwen3-1.7B}"

# ---- node2 (target host) ---------------------------------------------------
NODE2_PY="${NODE2_PY:-/home/hdd/zhangh/envs/new_fastsd/bin/python}"
TARGET_GPU="${TARGET_GPU:-1}"            # A6000
CLOUD_SERVICE_HOST="${CLOUD_SERVICE_HOST:-0.0.0.0}"
CLOUD_SERVICE_PORT="${CLOUD_SERVICE_PORT:-8003}"

# ---- node3 (edge host) -----------------------------------------------------
NODE3_PY="${NODE3_PY:-/home/zhangh/envs/fastsd_cpu/bin/python}"
DRAFT_GPU="${DRAFT_GPU:-0}"              # only used by a GPU-draft condition
SSH_NODE2="${SSH_NODE2:-zhangh@node2.sanzo.top}"
# When direct HTTP is blocked, client.sh tunnels over SSH to this loopback port.
TUNNEL_LOCAL_PORT="${TUNNEL_LOCAL_PORT:-18003}"
TARGET_URL="${TARGET_URL:-http://127.0.0.1:${TUNNEL_LOCAL_PORT}}"

# ---- KV residency / prefetch ----------------------------------------------
# 0  => every cache stays on the GPU (no offload, no prefetch).
# >0 => budget in MiB; eviction and prefetch become active.
KV_RESIDENCY_BUDGET_MB="${KV_RESIDENCY_BUDGET_MB:-0}"
KV_HIGH="${KV_HIGH:-0.90}"
KV_LOW="${KV_LOW:-0.75}"
# No calibration file: compute-window DMA runs at this fraction of the idle
# rate and disables itself after repeated disturbance. 0 = strict gate.
KV_PREFETCH_ONLINE_FRACTION="${KV_PREFETCH_ONLINE_FRACTION:-0.25}"
KV_PREFETCH_MB="${KV_PREFETCH_MB:-64}"

# ---- timing ----------------------------------------------------------------
HEALTH_TIMEOUT_S="${HEALTH_TIMEOUT_S:-900}"
RUN_TIMEOUT_S="${RUN_TIMEOUT_S:-3600}"
DRY_RUN="${DRY_RUN:-0}"
